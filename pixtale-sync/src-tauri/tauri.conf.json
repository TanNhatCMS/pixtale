{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixtale Sync",
  "version": "0.1.0",
  "identifier": "com.pixtale.sync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixtale Sync",
        "decorations": false,
        "width": 1000,
        "height": 640,
        "minHeight": 640,
        "minWidth": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:pixtale.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
